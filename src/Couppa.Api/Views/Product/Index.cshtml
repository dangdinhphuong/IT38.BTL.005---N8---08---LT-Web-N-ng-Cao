@model ProductListViewModel
@{
    ViewData["Title"] = "Danh sách sản phẩm - Couppa";
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sản phẩm</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Sidebar Filter -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-funnel me-2"></i>Bộ Lọc Danh Mục</h5>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-search="@Model.SearchKeyword" asp-route-sort="@Model.SortBy"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.SelectedCategoryId == null ? "active rounded-3" : "")">
                        Tất cả danh mục
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-action="Index" asp-route-category="@cat.Id" asp-route-search="@Model.SearchKeyword" asp-route-sort="@Model.SortBy"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.SelectedCategoryId == cat.Id ? "active rounded-3" : "")">
                            @cat.Name
                            <span class="badge bg-secondary rounded-pill">@cat.ProductCount</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
                <div>
                    <h4 class="fw-bold mb-1">
                        @(Model.SelectedCategoryId == null ? "Tất cả sản phẩm" : Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId)?.Name ?? "Danh mục")
                    </h4>
                    <span class="text-muted small">Tìm thấy <strong>@Model.TotalItems</strong> sản phẩm</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Sắp xếp:</label>
                    <select class="form-select form-select-sm rounded-pill" onchange="location = this.value;">
                        <option value="@Url.Action("Index", new { category = Model.SelectedCategoryId, search = Model.SearchKeyword, sort = "newest" })" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                        <option value="@Url.Action("Index", new { category = Model.SelectedCategoryId, search = Model.SearchKeyword, sort = "price_asc" })" selected="@(Model.SortBy == "price_asc")">Giá thấp đến cao</option>
                        <option value="@Url.Action("Index", new { category = Model.SelectedCategoryId, search = Model.SearchKeyword, sort = "price_desc" })" selected="@(Model.SortBy == "price_desc")">Giá cao đến thấp</option>
                    </select>
                </div>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <i class="bi bi-search fs-1 text-muted"></i>
                    <h5 class="mt-3 fw-bold">Không tìm thấy sản phẩm phù hợp</h5>
                    <p class="text-muted">Vui lòng thử từ khóa tìm kiếm hoặc chọn danh mục khác.</p>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Xem tất cả sản phẩm</a>
                </div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    @foreach (var p in Model.Products)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="card card-product h-100 shadow-sm">
                                <img src="@p.PrimaryImageUrl" class="card-img-top" alt="@p.Name">
                                <div class="card-body d-flex flex-column">
                                    <span class="badge-category align-self-start mb-2">@p.CategoryName</span>
                                    <h6 class="card-title fw-bold text-truncate mb-2">
                                        <a asp-action="Detail" asp-route-id="@p.Id" class="text-dark text-decoration-none">@p.Name</a>
                                    </h6>
                                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                                        <div>
                                            <div class="fw-bold text-primary fs-5">@p.Price.ToString("N0") đ</div>
                                            <small class="@(p.StockQuantity > 0 ? "text-success" : "text-danger")">
                                                @(p.StockQuantity > 0 ? $"Còn hàng ({p.StockQuantity})" : "Hết hàng")
                                            </small>
                                        </div>
                                        <button type="button" class="btn btn-primary btn-sm rounded-circle p-2 js-add-to-cart" data-product-id="@p.Id" @(p.StockQuantity <= 0 ? "disabled" : "") title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="d-flex justify-content-center">
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-category="@Model.SelectedCategoryId" asp-route-search="@Model.SearchKeyword" asp-route-sort="@Model.SortBy" asp-route-page="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-ajax.js" asp-append-version="true"></script>
}
