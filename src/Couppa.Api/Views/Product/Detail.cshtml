@model ProductDetailViewModel
@{
    ViewData["Title"] = $"{Model.Product.Name} - Couppa";
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6 text-center">
                <img src="@Model.Product.PrimaryImageUrl" class="img-fluid rounded-4 shadow-sm" style="max-height: 400px; object-fit: contain;" alt="@Model.Product.Name">
            </div>
            <div class="col-lg-6">
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold mb-2">@Model.Product.CategoryName</span>
                <h2 class="fw-bold mb-3">@Model.Product.Name</h2>
                <div class="display-6 fw-bold text-primary mb-3">@Model.Product.Price.ToString("N0") VNĐ</div>

                <div class="mb-4">
                    <span class="badge @(Model.Product.StockQuantity > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fs-6 px-3 py-2 rounded-pill">
                        <i class="bi @(Model.Product.StockQuantity > 0 ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                        @(Model.Product.StockQuantity > 0 ? $"Còn hàng ({Model.Product.StockQuantity} sản phẩm)" : "Hết hàng")
                    </span>
                </div>

                <p class="text-secondary leading-relaxed mb-4">@Model.Product.Description</p>

                <div class="d-flex gap-3 align-items-center">
                    <div style="width: 100px;">
                        <input type="number" id="quantityInput" value="1" min="1" max="@Model.Product.StockQuantity" class="form-control form-control-lg text-center rounded-pill" @(Model.Product.StockQuantity <= 0 ? "disabled" : "") />
                    </div>
                    <button type="button" class="btn btn-warning btn-lg rounded-pill px-4 fw-bold text-dark flex-grow-1 js-add-to-cart" data-product-id="@Model.Product.Id" data-quantity-input="#quantityInput" @(Model.Product.StockQuantity <= 0 ? "disabled" : "")>
                        <i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <h4 class="fw-bold mb-3">Sản phẩm liên quan</h4>
        <div class="row g-4">
            @foreach (var p in Model.RelatedProducts)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card card-product h-100 shadow-sm">
                        <img src="@p.PrimaryImageUrl" class="card-img-top" alt="@p.Name">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-truncate">
                                <a asp-action="Detail" asp-route-id="@p.Id" class="text-dark text-decoration-none">@p.Name</a>
                            </h6>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary">@p.Price.ToString("N0") đ</span>
                                <a asp-action="Detail" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm rounded-circle">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/cart-ajax.js" asp-append-version="true"></script>
}
