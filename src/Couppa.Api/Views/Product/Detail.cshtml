@model ProductDetailViewModel
@{
    ViewData["Title"] = $"{Model.Product.Name} - Couppa";
    bool outOfStock = Model.Product.StockQuantity <= 0;
}

<div class="container" style="padding-top: var(--space-4);">
    <!-- BREADCRUMB -->
    <div style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: var(--space-6);">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a> &nbsp;/&nbsp;
        <a asp-action="Index">Sản phẩm</a> &nbsp;/&nbsp;
        <span style="color: var(--color-text-main);">@Model.Product.Name</span>
    </div>

    <!-- PRODUCT DETAIL CARD LAYOUT -->
    <div class="card" style="padding: var(--space-8); background: white; margin-bottom: var(--space-12);">
        <div style="display: grid; grid-template-columns: 460px 1fr; gap: var(--space-12); align-items: start;">
            
            <!-- LEFT: IMAGE GALLERY -->
            <div>
                <div style="border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); margin-bottom: var(--space-4);">
                    <img id="detail-main-img" src="@Model.Product.PrimaryImageUrl" alt="@Model.Product.Name" style="width: 100%; height: 380px; object-fit: cover;">
                </div>
            </div>

            <!-- RIGHT: PRODUCT INFO & ACTION -->
            <div>
                <span class="product-category" style="font-size: 0.875rem;">@Model.Product.CategoryName</span>
                <h1 style="margin-top: 4px; margin-bottom: var(--space-2);">@Model.Product.Name</h1>
                
                <div class="flex items-center gap-4" style="margin-bottom: var(--space-4);">
                    <span class="caption">Mã SKU: <strong style="color: var(--color-text-main);">@Model.Product.Sku</strong></span>
                    <span class="caption">|</span>
                    <span class="badge @(outOfStock ? "badge-danger" : "badge-success")">
                        @(outOfStock ? "Hết hàng" : $"Còn hàng ({Model.Product.StockQuantity})")
                    </span>
                </div>

                <div style="font-size: 2rem; font-weight: 800; color: var(--color-primary); margin-bottom: var(--space-6);">
                    @Model.Product.Price.ToString("N0") VNĐ
                </div>

                <div style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: var(--space-4) 0; margin-bottom: var(--space-6);">
                    <h4 style="margin-bottom: 8px;">Mô tả sản phẩm:</h4>
                    <p style="color: var(--color-text-muted);">@Model.Product.Description</p>
                </div>

                <!-- QUANTITY & ADD TO CART -->
                <div class="flex items-center gap-6" style="margin-bottom: var(--space-6);">
                    <div>
                        <label class="form-label" style="margin-bottom: 6px; display: block;">Số lượng mua:</label>
                        <div class="quantity-control">
                            <button type="button" class="quantity-btn" onclick="let input=document.getElementById('quantityInput'); if(parseInt(input.value)>1) input.value=parseInt(input.value)-1;">-</button>
                            <input type="number" id="quantityInput" class="quantity-input" value="1" min="1" max="@Model.Product.StockQuantity" readonly>
                            <button type="button" class="quantity-btn" onclick="let input=document.getElementById('quantityInput'); if(parseInt(input.value)<@Model.Product.StockQuantity) input.value=parseInt(input.value)+1;">+</button>
                        </div>
                    </div>

                    <div style="flex: 1; margin-top: 24px;">
                        <button type="button" class="btn btn-primary btn-lg btn-block js-add-to-cart" data-product-id="@Model.Product.Id" data-quantity-input="#quantityInput" @(outOfStock ? "disabled" : "")>
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"></path></svg>
                            @(outOfStock ? "Sản Phẩm Đã Hết Hàng" : "Thêm Vào Giỏ Hàng")
                        </button>
                    </div>
                </div>

                <div style="background-color: var(--color-primary-light); padding: var(--space-4); border-radius: var(--radius-md); color: var(--color-primary); font-size: 0.85rem;">
                    ✓ Cam kết chính hãng 100% &nbsp;|&nbsp; ✓ Giao hàng nhanh toàn quốc &nbsp;|&nbsp; ✓ Đổi trả trong 7 ngày
                </div>

            </div>

        </div>
    </div>

    <!-- RELATED PRODUCTS -->
    @if (Model.RelatedProducts.Any())
    {
        <section style="margin-bottom: var(--space-12);">
            <h3 style="margin-bottom: var(--space-6);">Sản Phẩm Cùng Danh Mục</h3>
            <div class="grid grid-cols-4">
                @foreach (var p in Model.RelatedProducts)
                {
                    bool relOutOfStock = p.StockQuantity <= 0;
                    <div class="card product-card">
                        <div class="product-card-img-wrapper">
                            <img src="@p.PrimaryImageUrl" alt="@p.Name" class="product-card-img">
                            @if (relOutOfStock)
                            {
                                <span class="product-card-badge out-of-stock">Hết hàng</span>
                            }
                        </div>
                        <div class="product-card-content">
                            <span class="product-category">@p.CategoryName</span>
                            <a asp-action="Detail" asp-route-id="@p.Id" class="product-title">@p.Name</a>
                            <div class="product-price-row">
                                <div>
                                    <div class="product-price">@p.Price.ToString("N0") đ</div>
                                    <div class="stock-status @(p.StockQuantity > 0 ? "in-stock" : "out-of-stock")">
                                        @(p.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm js-add-to-cart" data-product-id="@p.Id" @(relOutOfStock ? "disabled" : "")>
                                    + Giỏ
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/cart-ajax.js" asp-append-version="true"></script>
}
