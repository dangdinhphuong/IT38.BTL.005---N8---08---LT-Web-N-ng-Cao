@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Mới - Couppa";
}

<div class="container flex items-center justify-center" style="padding-top: var(--space-8); padding-bottom: var(--space-8);">
    <div style="max-width: 480px; width: 100%;">
        <div class="card" style="padding: var(--space-8); background: white;">
            <div style="text-align: center; margin-bottom: var(--space-6);">
                <h2>Đăng Ký Tài Khoản</h2>
                <p class="caption" style="margin-top: 4px;">Tạo tài khoản cá nhân để xem & lưu trữ giỏ hàng lâu dài</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="form-error mb-3" role="alert"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="FullName">Họ và Tên <span class="required">*</span></label>
                    <input asp-for="FullName" class="form-input" placeholder="Ví dụ: Nguyễn Văn A" required />
                    <span asp-validation-for="FullName" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">Địa chỉ Email <span class="required">*</span></label>
                    <input asp-for="Email" class="form-input" placeholder="email@domain.com" required />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Password">Mật khẩu <span class="required">*</span></label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="••••••••" required />
                    <span class="form-hint">Yêu cầu tối thiểu 8 ký tự, ít nhất 1 chữ hoa và 1 chữ số.</span>
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmPassword">Xác nhận mật khẩu <span class="required">*</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="••••••••" required />
                    <span asp-validation-for="ConfirmPassword" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="PhoneNumber">Số điện thoại (tùy chọn)</label>
                    <input asp-for="PhoneNumber" class="form-input" placeholder="0901234567" />
                    <span asp-validation-for="PhoneNumber" class="form-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--space-4);">
                    Tạo Tài Khoản
                </button>
            </form>

            <div style="text-align: center; margin-top: var(--space-6); font-size: 0.875rem; color: var(--color-text-muted);">
                Đã có tài khoản? <a asp-action="Login" style="color: var(--color-primary); font-weight: 600;">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
