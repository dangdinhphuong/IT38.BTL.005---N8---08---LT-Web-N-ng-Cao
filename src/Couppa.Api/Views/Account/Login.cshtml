@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản - Couppa";
}

<div class="container flex items-center justify-center" style="padding-top: var(--space-8); padding-bottom: var(--space-8);">
    <div style="max-width: 440px; width: 100%;">
        <div class="card" style="padding: var(--space-8); background: white;">
            <div style="text-align: center; margin-bottom: var(--space-6);">
                <h2>Đăng Nhập</h2>
                <p class="caption" style="margin-top: 4px;">Nhập email và mật khẩu của bạn để truy cập hệ thống</p>
            </div>

            <!-- QUICK DEMO LOGINS -->
            <div style="background: var(--color-primary-light); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); margin-bottom: var(--space-6); font-size: 0.8125rem;">
                <div style="font-weight: 700; color: var(--color-primary); margin-bottom: 4px;">Đăng Nhập Nhanh (Demo Accounts):</div>
                <div class="flex gap-2" style="margin-top: 6px;">
                    <button type="button" onclick="fillCredentials('user@couppa.com', 'User123@')" class="btn btn-outline btn-sm" style="flex: 1; background: white;">User Demo</button>
                    <button type="button" onclick="fillCredentials('admin@couppa.com', 'Admin123@')" class="btn btn-primary btn-sm" style="flex: 1;">Admin Demo</button>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="form-error mb-3" role="alert"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">Địa chỉ Email <span class="required">*</span></label>
                    <input asp-for="Email" id="login-email" class="form-input" placeholder="user@couppa.com" required />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Password">Mật khẩu <span class="required">*</span></label>
                    <input asp-for="Password" id="login-password" type="password" class="form-input" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: var(--space-6);">
                    <label class="checkbox-label">
                        <input asp-for="RememberMe" class="form-check-input" /> Ghi nhớ đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg">
                    Đăng Nhập
                </button>
            </form>

            <div style="text-align: center; margin-top: var(--space-6); font-size: 0.875rem; color: var(--color-text-muted);">
                Chưa có tài khoản? <a asp-action="Register" style="color: var(--color-primary); font-weight: 600;">Đăng ký tài khoản mới</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, pass) {
            document.getElementById('login-email').value = email;
            document.getElementById('login-password').value = pass;
        }
    </script>
}
