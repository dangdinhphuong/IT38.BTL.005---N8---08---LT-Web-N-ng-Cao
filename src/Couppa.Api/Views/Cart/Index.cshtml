@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng của bạn - Couppa";
}

<div class="container" style="padding-top: var(--space-4);">
    
    <div class="flex justify-between items-center" style="margin-bottom: var(--space-6);">
        <h1>Giỏ Hàng Của Bạn</h1>
        @if (Model.Cart != null && Model.Cart.Items.Any())
        {
            <button type="button" class="btn btn-outline btn-sm js-clear-cart" style="color: var(--color-error); border-color: var(--color-error-light);">
                <i class="bi bi-trash me-1"></i> Xóa Toàn Bộ Giỏ Hàng
            </button>
        }
    </div>

    @if (Model.Cart == null || !Model.Cart.Items.Any())
    {
        <div class="empty-state" style="background: white; border-radius: var(--radius-xl); border: 1px solid var(--color-border); padding: var(--space-16) var(--space-6);">
            <div class="empty-state-icon">
                <i class="bi bi-cart-x"></i>
            </div>
            <h2 class="empty-state-title">Giỏ Hàng Đang Trống</h2>
            <p class="empty-state-desc">Bạn chưa thêm bất kỳ sản phẩm nào vào giỏ hàng. Hãy khám phá danh mục và chọn sản phẩm yêu thích ngay!</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                Khám Phá Sản Phẩm
            </a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            
            <!-- CART ITEMS TABLE -->
            <div class="card" style="background: white;">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Sản Phẩm</th>
                            <th>Đơn Giá</th>
                            <th>Số Lượng</th>
                            <th>Tạm Tính</th>
                            <th style="text-align: right;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cart.Items)
                        {
                            <tr data-cart-item="@item.Id">
                                <td>
                                    <div class="cart-item-info">
                                        <img src="@item.ProductImageUrl" alt="@item.ProductName" class="cart-item-img">
                                        <div>
                                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" style="font-weight: 600; color: var(--color-text-main);">@item.ProductName</a>
                                            @if (!item.IsAvailable)
                                            {
                                                <div><span class="badge badge-danger">Không khả dụng</span></div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td style="font-weight: 600;">@item.Price.ToString("N0") đ</td>
                                <td>
                                    <div class="quantity-control">
                                        <button type="button" class="quantity-btn" @(item.IsAvailable ? "" : "disabled") onclick="let input=this.nextElementSibling; if(parseInt(input.value)>1) { input.value=parseInt(input.value)-1; input.dispatchEvent(new Event('change', {bubbles: true})); }">-</button>
                                        <input type="number" value="@item.Quantity" min="1" class="quantity-input js-cart-quantity" data-item-id="@item.Id" @(item.IsAvailable ? "" : "disabled") readonly />
                                        <button type="button" class="quantity-btn" @(item.IsAvailable ? "" : "disabled") onclick="let input=this.previousElementSibling; input.value=parseInt(input.value)+1; input.dispatchEvent(new Event('change', {bubbles: true}));">+</button>
                                    </div>
                                </td>
                                <td style="font-weight: 700; color: var(--color-primary);">@item.Subtotal.ToString("N0") đ</td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn btn-outline btn-sm js-remove-cart-item" data-item-id="@item.Id" style="color: var(--color-error); border: none;" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- CART SUMMARY CARD -->
            <div class="cart-summary-card">
                <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-3);">Tóm Tắt Đơn Hàng</h3>

                <div class="summary-row">
                    <span>Tổng số lượng sản phẩm:</span>
                    <strong id="cart-total-items">@Model.TotalItems</strong>
                </div>
                <div class="summary-row">
                    <span>Tạm tính giỏ hàng:</span>
                    <strong id="cart-subtotal">@Model.TotalAmount.ToString("N0") đ</strong>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển:</span>
                    <span style="color: var(--color-success); font-weight: 600;">Miễn phí</span>
                </div>

                <div class="summary-row total">
                    <span>Tổng Thành Tiền:</span>
                    <span style="color: var(--color-primary);">@Model.TotalAmount.ToString("N0") đ</span>
                </div>

                <div style="margin-top: var(--space-6);">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-block btn-lg">
                        Tiếp Tục Mua Sắm
                    </a>
                    <p class="caption" style="text-align: center; margin-top: var(--space-3);">
                        (Hệ thống giới thiệu sản phẩm & giỏ hàng — Không có thanh toán online)
                    </p>
                </div>
            </div>

        </div>
    }

</div>

@section Scripts {
    <script src="~/js/cart-ajax.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('change', (event) => {
            const input = event.target.closest('.js-cart-quantity');
            if (input) window.couppaCartAjax?.updateItem(input.dataset.itemId, Number(input.value));
        });
        document.addEventListener('click', (event) => {
            const remove = event.target.closest('.js-remove-cart-item');
            if (remove) window.couppaCartAjax?.removeItem(remove.dataset.itemId);
            const clear = event.target.closest('.js-clear-cart');
            if (clear && confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')) window.couppaCartAjax?.clear();
        });
    </script>
}
