@model AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard - Couppa";
}

<div class="admin-wrapper">
    <!-- ADMIN SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right: 8px;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            Couppa Admin
        </div>

        <nav class="admin-menu">
            <a href="/Admin/Dashboard/Index" class="admin-menu-item active">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a href="/Admin/Product/Index" class="admin-menu-item">
                <i class="bi bi-box-seam me-2"></i> Quản Lý Sản Phẩm
            </a>
            <a href="/Admin/Category/Index" class="admin-menu-item">
                <i class="bi bi-tags me-2"></i> Quản Lý Danh Mục
            </a>
            <a href="/Admin/User/Index" class="admin-menu-item">
                <i class="bi bi-people me-2"></i> Quản Lý Người Dùng
            </a>
            <a href="/Admin/Report/CartTopProducts" class="admin-menu-item">
                <i class="bi bi-bar-chart me-2"></i> Báo Cáo Thống Kê
            </a>
        </nav>

        <div style="margin-top: auto; padding: var(--space-4); border-top: 1px solid #1E293B;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline btn-block btn-sm" style="color: #94A3B8; border-color: #334155;">
                &larr; Xem Website Public
            </a>
        </div>
    </aside>

    <!-- ADMIN MAIN SECTION -->
    <div class="admin-main">
        <header class="admin-topbar">
            <h3 style="margin: 0;">Tổng Quan System Dashboard</h3>
            <div class="flex items-center gap-4">
                <span class="badge badge-info" style="padding: 6px 12px;">Role: Admin</span>
                <a asp-controller="User" asp-action="Profile" class="btn btn-outline btn-sm">Admin Account</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline btn-sm" style="color: var(--color-error); border-color: var(--color-error-light);">Đăng Xuất</button>
                </form>
            </div>
        </header>

        <main class="admin-content">
            <!-- KPI STAT CARDS -->
            <div class="stat-grid">
                <div class="stat-card">
                    <div>
                        <div class="stat-title">Tổng Số Sản Phẩm</div>
                        <div class="stat-val">@Model.Summary.TotalProducts</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div>
                        <div class="stat-title">Danh Mục Đang Active</div>
                        <div class="stat-val">@Model.Summary.TotalCategories</div>
                    </div>
                    <div class="stat-icon" style="background-color: var(--color-secondary-light); color: var(--color-secondary);">
                        <i class="bi bi-tags"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div>
                        <div class="stat-title">Tổng Người Dùng</div>
                        <div class="stat-val">@Model.Summary.TotalUsers</div>
                    </div>
                    <div class="stat-icon" style="background-color: #DBEAFE; color: #2563EB;">
                        <i class="bi bi-people"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div>
                        <div class="stat-title">Sản Phẩm Hết Hàng</div>
                        <div class="stat-val" style="color: var(--color-error);">@Model.Summary.OutOfStockProducts</div>
                    </div>
                    <div class="stat-icon" style="background-color: var(--color-error-light); color: var(--color-error);">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>

            <!-- CHARTS & RECENT PRODUCTS -->
            <div class="grid grid-cols-2" style="gap: var(--space-8); margin-bottom: var(--space-8);">
                <div class="card" style="padding: var(--space-6); background: white;">
                    <h4 style="margin-bottom: var(--space-4);">Sản Phẩm Theo Danh Mục</h4>
                    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                        @if (Model.Summary.ProductsByCategory != null && Model.Summary.ProductsByCategory.Any())
                        {
                            int maxCount = Model.Summary.ProductsByCategory.Max(c => c.Count);
                            if (maxCount == 0) maxCount = 1;
                            foreach (var c in Model.Summary.ProductsByCategory)
                            {
                                int percent = (int)Math.Round((double)c.Count / maxCount * 100);
                                <div>
                                    <div class="flex justify-between" style="font-size: 0.8125rem; font-weight: 500; margin-bottom: 4px;">
                                        <span>@c.CategoryName</span>
                                        <strong>@c.Count sản phẩm</strong>
                                    </div>
                                    <div style="height: 10px; background: #E2E8F0; border-radius: var(--radius-full); overflow: hidden;">
                                        <div style="width: @(percent)%; height: 100%; background: var(--color-primary); border-radius: var(--radius-full);"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card" style="padding: var(--space-6); background: white;">
                    <h4 style="margin-bottom: var(--space-4);">Trạng Thái Caching (IMemoryCache)</h4>
                    <ul style="display: flex; flex-direction: column; gap: var(--space-3); font-size: 0.875rem;">
                        <li class="flex justify-between items-center" style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
                            <span>Cache Key: <code>categories:active</code></span>
                            <span class="badge badge-success">Hit (TTL 15 phút)</span>
                        </li>
                        <li class="flex justify-between items-center" style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
                            <span>Cache Key: <code>products:featured</code></span>
                            <span class="badge badge-success">Hit (TTL 10 phút)</span>
                        </li>
                        <li class="flex justify-between items-center" style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
                            <span>Cache Key: <code>admin:dashboard:summary</code></span>
                            <span class="badge badge-success">Hit (TTL 5 phút)</span>
                        </li>
                    </ul>
                    <p class="caption" style="margin-top: var(--space-4);">
                        Dữ liệu Dashboard được tính toán và lưu cache server-side theo chuẩn <code>IMemoryCache</code> trong SRS (NFR-CACHE-01).
                    </p>
                </div>
            </div>

            <!-- RECENT PRODUCTS TABLE -->
            <div class="data-table-container">
                <div class="table-toolbar">
                    <h4>Sản Phẩm Mới Thêm Gần Đây</h4>
                    <a href="/Admin/Product/Index" class="btn btn-outline btn-sm">Xem tất cả sản phẩm &rarr;</a>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Mã ID</th>
                            <th>Tên Sản Phẩm</th>
                            <th>Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Summary.RecentProducts)
                        {
                            <tr>
                                <td style="font-weight: 700;">#@item.Id</td>
                                <td style="font-weight: 600;">@item.Name</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>
