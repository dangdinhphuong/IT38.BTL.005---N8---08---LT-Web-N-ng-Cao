@model AdminCategoriesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Danh mục - Admin Couppa";
}

<div class="admin-wrapper">
    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right: 8px;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            Couppa Admin
        </div>

        <nav class="admin-menu">
            <a href="/Admin/Dashboard/Index" class="admin-menu-item">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a href="/Admin/Product/Index" class="admin-menu-item">
                <i class="bi bi-box-seam me-2"></i> Quản Lý Sản Phẩm
            </a>
            <a href="/Admin/Category/Index" class="admin-menu-item active">
                <i class="bi bi-tags me-2"></i> Quản Lý Danh Mục
            </a>
            <a href="/Admin/User/Index" class="admin-menu-item">
                <i class="bi bi-people me-2"></i> Quản Lý Người Dùng
            </a>
            <a href="/Admin/Report/CartTopProducts" class="admin-menu-item">
                <i class="bi bi-bar-chart me-2"></i> Báo Cáo Thống Kê
            </a>
        </nav>

        <div style="margin-top: auto; padding: var(--space-4); border-top: 1px solid #1E293B;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline btn-block btn-sm" style="color: #94A3B8; border-color: #334155;">&larr; Xem Website Public</a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="admin-main">
        <header class="admin-topbar">
            <h3>Quản Lý Danh Mục Sản Phẩm</h3>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                <i class="bi bi-plus-lg me-1"></i> Thêm Danh Mục Mới
            </button>
        </header>

        <main class="admin-content">
            <div class="data-table-container">
                <div class="table-toolbar">
                    <span class="caption">Tổng số: <strong>@Model.Categories.Count</strong> danh mục</span>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tên Danh Mục</th>
                            <th>Slug (URL)</th>
                            <th>Mô Tả</th>
                            <th>Số SP Linked</th>
                            <th>Trạng Thái</th>
                            <th style="text-align: right;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="categoryRows">
                        @foreach (CategoryResponse cat in Model.Categories)
                        {
                            <tr data-id="@cat.Id">
                                <td style="font-weight: 700;">#@cat.Id</td>
                                <td style="font-weight: 600;">@cat.Name</td>
                                <td><code>@cat.Slug</code></td>
                                <td class="caption">@cat.Description</td>
                                <td>
                                    <span class="badge badge-info">@cat.ProductCount sản phẩm</span>
                                </td>
                                <td>
                                    <span class="badge @(cat.IsActive ? "badge-success" : "badge-danger")">
                                        @(cat.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn btn-outline btn-sm js-toggle-category-status" data-id="@cat.Id" data-active="@cat.IsActive.ToString().ToLowerInvariant()" title="Đổi trạng thái" style="margin-right: 4px;">
                                        <i class="bi bi-power"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline btn-sm js-delete-category" data-id="@cat.Id" title="Xóa" style="color: var(--color-error); border-color: var(--color-error-light);">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<!-- Modal Create Category -->
<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header" style="border-bottom: 1px solid var(--color-border); padding: var(--space-4) var(--space-6);">
                <h3 class="modal-title m-0">Thêm Danh Mục Mới</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createCategoryForm">
                <div class="modal-body" style="padding: var(--space-6);">
                    <div class="form-group">
                        <label class="form-label">Tên danh mục <span class="required">*</span></label>
                        <input type="text" name="name" class="form-input" required placeholder="vd: Đồng hồ thông minh" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Slug URL <span class="required">*</span></label>
                        <input type="text" name="slug" class="form-input" required placeholder="vd: dong-ho-thong-minh" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Mô tả</label>
                        <textarea name="description" class="form-textarea" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--color-border); padding: var(--space-4) var(--space-6);">
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Hủy Bỏ</button>
                    <button type="submit" class="btn btn-primary">Lưu Danh Mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-ajax.js" asp-append-version="true"></script>
    <script>
        document.getElementById('createCategoryForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const form = e.target;
            const payload = {
                name: form.name.value,
                slug: form.slug.value,
                description: form.description.value
            };
            const result = await window.couppaAdminAjax.postJson('/Admin/Category/Create', payload);
            if (result.success) {
                location.reload();
            } else {
                alert(result.error?.message || 'Không thể tạo danh mục.');
            }
        });

        document.addEventListener('click', async function (e) {
            const toggle = e.target.closest('.js-toggle-category-status');
            if (toggle) {
                const isActive = toggle.dataset.active !== 'true';
                const result = await window.couppaAdminAjax.postJson(`/Admin/Category/ToggleStatus/${toggle.dataset.id}`, { isActive });
                if (result.success) {
                    toggle.dataset.active = isActive.toString();
                    const status = toggle.closest('tr')?.querySelector('td:nth-child(6) span');
                    if (status) {
                        status.className = `badge ${isActive ? 'badge-success' : 'badge-danger'}`;
                        status.textContent = isActive ? 'Active' : 'Inactive';
                    }
                } else {
                    alert(result.error?.message || 'Không thể cập nhật trạng thái danh mục.');
                }
                return;
            }
            const btn = e.target.closest('.js-delete-category');
            if (!btn) return;
            if (!confirm('Bạn có chắc chắn muốn xóa danh mục này?')) return;

            const result = await window.couppaAdminAjax.postJson(`/Admin/Category/Delete/${btn.dataset.id}`, null);
            if (result.success) {
                btn.closest('tr')?.remove();
            } else {
                alert(result.error?.message || 'Không thể xóa danh mục.');
            }
        });
    </script>
}
