@model UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân - Couppa";
}

<div class="container" style="max-width: 900px; padding-top: var(--space-4);">
    
    <h1 style="margin-bottom: var(--space-6);">Hồ Sơ Cá Nhân</h1>

    <div class="grid grid-cols-3" style="gap: var(--space-8); align-items: start;">
        
        <!-- PROFILE SUMMARY CARD -->
        <div class="card" style="padding: var(--space-6); background: white; text-align: center;">
            <div style="width: 80px; height: 80px; border-radius: var(--radius-full); background: var(--color-primary-light); color: var(--color-primary); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-4); font-size: 2rem; font-weight: 700;">
                @(string.IsNullOrEmpty(Model.User.FullName) ? "U" : Model.User.FullName.Substring(0, 1).ToUpper())
            </div>
            <h3>@Model.User.FullName</h3>
            <p class="caption" style="margin-bottom: var(--space-3);">@Model.User.Email</p>
            
            <span class="badge badge-info">Role: @Model.User.Role</span>

            <div style="border-top: 1px solid var(--color-border); margin-top: var(--space-6); padding-top: var(--space-4); text-align: left; font-size: 0.85rem; color: var(--color-text-muted);">
                <div class="mb-2"><i class="bi bi-calendar3 me-2"></i> Ngày tham gia: @Model.User.CreatedAt.ToString("dd/MM/yyyy")</div>
                <div><i class="bi bi-telephone me-2"></i> SĐT: @(Model.User.Phone ?? "Chưa cập nhật")</div>
            </div>

            <div style="border-top: 1px solid var(--color-border); margin-top: var(--space-4); padding-top: var(--space-4);">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline btn-block btn-sm" style="color: var(--color-error); border-color: var(--color-error-light);">
                        Đăng Xuất Tài Khoản
                    </button>
                </form>
            </div>
        </div>

        <!-- PROFILE EDIT & CHANGE PASSWORD FORMS -->
        <div style="grid-column: span 2; display: flex; flex-direction: column; gap: var(--space-8);">
            
            <div class="card" style="padding: var(--space-6); background: white;">
                <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2);">Cập Nhật Thông Tin Cá Nhân</h3>
                
                <form asp-controller="User" asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="form-error mb-3" role="alert"></div>

                    <div class="form-group">
                        <label class="form-label">Địa chỉ Email (Không thể thay đổi)</label>
                        <input type="email" class="form-input" value="@Model.User.Email" disabled style="background: var(--color-bg);" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="FullName">Họ và Tên <span class="required">*</span></label>
                        <input asp-for="FullName" class="form-input" required />
                        <span asp-validation-for="FullName" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Phone">Số điện thoại</label>
                        <input asp-for="Phone" class="form-input" placeholder="0901234567" />
                        <span asp-validation-for="Phone" class="form-error"></span>
                    </div>

                    <div style="border-top: 1px solid var(--color-border); margin-top: var(--space-6); padding-top: var(--space-4);">
                        <h4 style="margin-bottom: var(--space-4);">Đổi Mật Khẩu (Tùy chọn)</h4>

                        <div class="form-group">
                            <label class="form-label" asp-for="OldPassword">Mật khẩu hiện tại</label>
                            <input asp-for="OldPassword" type="password" class="form-input" placeholder="Chỉ nhập khi muốn đổi..." />
                        </div>

                        <div class="form-group">
                            <label class="form-label" asp-for="NewPassword">Mật khẩu mới</label>
                            <input asp-for="NewPassword" type="password" class="form-input" placeholder="Mới (tối thiểu 8 ký tự)" />
                            <span class="form-hint">Yêu cầu tối thiểu 8 ký tự, ít nhất 1 chữ hoa và 1 chữ số.</span>
                            <span asp-validation-for="NewPassword" class="form-error"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="margin-top: var(--space-4);">
                        Lưu Thay Đổi
                    </button>
                </form>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
