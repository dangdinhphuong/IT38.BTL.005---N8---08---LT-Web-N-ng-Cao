<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Couppa Tech Store</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-couppa-primary shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-layers-fill fs-3 text-warning"></i> Couppa
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Product" asp-action="Index">Tất cả sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Product" asp-action="Index" asp-route-category="dien-thoai-tablet">Điện thoại</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Product" asp-action="Index" asp-route-category="laptop-tin-hoc">Laptop</a>
                        </li>
                    </ul>

                    <!-- Global Search Form -->
                    <form class="d-flex me-3" asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control form-control-sm border-0 rounded-start-pill ps-3" type="search" name="search" placeholder="Tìm sản phẩm..." aria-label="Search">
                            <button class="btn btn-warning text-dark btn-sm rounded-end-pill px-3" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Cart & User Actions -->
                    <div class="d-flex align-items-center gap-3">
                        <a class="btn btn-outline-light position-relative rounded-pill px-3 py-1 btn-sm" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3 me-1"></i> Giỏ hàng
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle btn-sm rounded-pill px-3 fw-semibold text-primary" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ cá nhân</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger fw-semibold" href="/Admin/Dashboard/Index"><i class="bi bi-speedometer2 me-2"></i> Admin Dashboard</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-secondary"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-light btn-sm rounded-pill px-3 fw-semibold text-primary" asp-controller="Account" asp-action="Login">
                                Đăng nhập
                            </a>
                            <a class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold text-dark" asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Notification Banners -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-layers-fill text-warning me-2"></i>Couppa</h5>
                    <p class="small text-muted">Hệ thống giới thiệu sản phẩm và bán hàng điện tử hiện đại, tối ưu trải nghiệm mua sắm trên nền tảng ASP.NET Core MVC & Bootstrap 5.</p>
                    <p class="small text-muted mb-0">&copy; 2026 Couppa Inc. All rights reserved.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="text-white fw-semibold mb-3">Khám phá</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="mb-2"><a asp-controller="Product" asp-action="Index">Tất cả sản phẩm</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="text-white fw-semibold mb-3">Tài khoản</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        <li class="mb-2"><a asp-controller="User" asp-action="Profile">Hồ sơ cá nhân</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="text-white fw-semibold mb-3">Quản trị viên</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a href="/Admin/Dashboard/Index">Admin Dashboard</a></li>
                        <li class="mb-2"><a href="/Admin/Product/Index">Quản lý Sản phẩm</a></li>
                        <li class="mb-2"><a href="/Admin/Category/Index">Quản lý Danh mục</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
