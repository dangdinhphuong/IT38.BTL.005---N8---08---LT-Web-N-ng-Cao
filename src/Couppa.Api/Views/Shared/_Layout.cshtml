<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Couppa Tech Store</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

  <!-- MASTER SITE HEADER -->
  <header class="site-header">
    <div class="container header-inner">
      <a asp-controller="Home" asp-action="Index" class="brand-logo">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
        Couppa
      </a>

      <nav class="nav-menu">
        <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">Trang chủ</a>
        <a asp-controller="Product" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">Sản phẩm</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="1" class="nav-link">Điện thoại</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="2" class="nav-link">Laptop</a>
        <a asp-controller="Product" asp-action="Index" asp-route-category="4" class="nav-link">Phụ kiện</a>
      </nav>

      <div class="header-search">
        <form asp-controller="Product" asp-action="Index" method="get" class="m-0">
          <svg class="header-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" name="search" id="global-search" placeholder="Tìm kiếm sản phẩm..." value="@Context.Request.Query["search"]">
        </form>
      </div>

      <div class="header-actions">
        <a asp-controller="Cart" asp-action="Index" class="icon-btn" title="Giỏ hàng">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"></path></svg>
          <span class="cart-badge js-cart-badge-count">0</span>
        </a>

        <div id="header-auth-area" class="d-flex align-items-center gap-2">
          @if (User.Identity?.IsAuthenticated == true)
          {
            <div class="dropdown">
              <button class="btn btn-outline btn-sm dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                <li><a class="dropdown-item" asp-controller="User" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ cá nhân</a></li>
                @if (User.IsInRole("Admin"))
                {
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-primary fw-semibold" href="/Admin/Dashboard/Index"><i class="bi bi-speedometer2 me-2"></i> Admin Dashboard</a></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                  </form>
                </li>
              </ul>
            </div>
          }
          else
          {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline btn-sm">Đăng nhập</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Đăng ký</a>
          }
        </div>
      </div>
    </div>
  </header>

  <!-- Notification Banners -->
  <div class="container mt-3">
    @if (TempData["SuccessMessage"] != null)
    {
      <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
      <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    }
  </div>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    @RenderBody()
  </main>

  <!-- MASTER SITE FOOTER -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-brand">Couppa</div>
          <p style="margin-bottom: var(--space-4);">Hệ thống giới thiệu sản phẩm và giỏ hàng đơn giản, tối ưu trải nghiệm người dùng và hiệu năng vận hành.</p>
          <p class="caption">&copy; 2026 Couppa Inc. All rights reserved.</p>
        </div>

        <div>
          <div class="footer-col-title">Khám Phá</div>
          <div class="footer-links">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
            <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
          </div>
        </div>

        <div>
          <div class="footer-col-title">Tài Khoản</div>
          <div class="footer-links">
            <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
            <a asp-controller="Account" asp-action="Register">Đăng ký</a>
            <a asp-controller="User" asp-action="Profile">Thông tin cá nhân</a>
          </div>
        </div>

        <div>
          <div class="footer-col-title">Quản Trị</div>
          <div class="footer-links">
            <a href="/Admin/Dashboard/Index">Admin Dashboard</a>
            <a href="/Admin/Product/Index">Quản lý sản phẩm</a>
            <a href="/Admin/Report/CartTopProducts">Báo cáo thống kê</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <span>Đồ án tốt nghiệp Đề tài 8 — Website Giới Thiệu Sản Phẩm và Giỏ Hàng Đơn Giản</span>
        <span>Kiến trúc: ASP.NET Core Web API + PostgreSQL + Cookie Auth</span>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
