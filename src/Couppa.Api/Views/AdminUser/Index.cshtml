@model AdminUsersViewModel
@{
    ViewData["Title"] = "Quản lý Người dùng - Admin Couppa";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people text-info me-2"></i>Quản lý Người dùng</h2>
            <p class="text-muted mb-0">Danh sách tài khoản và phân quyền quản trị</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Email</th>
                        <th>Họ và tên</th>
                        <th>Vai trò (Role)</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@user.Email</td>
                            <td>@user.FullName</td>
                            <td>
                                <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary") rounded-pill">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge @(user.IsLocked ? "bg-secondary" : "bg-success")">
                                    @(user.IsLocked ? "Đã khóa" : "Hoạt động")
                                </span>
                            </td>
                            <td class="small text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn @(user.IsLocked ? "btn-outline-success" : "btn-outline-warning") btn-sm rounded-pill px-3 js-toggle-lock"
                                        data-id="@user.Id" data-lock="@((!user.IsLocked).ToString().ToLowerInvariant())">
                                    <i class="bi @(user.IsLocked ? "bi-unlock" : "bi-lock") me-1"></i>
                                    @(user.IsLocked ? "Mở khóa" : "Khóa")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-ajax.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('.js-toggle-lock');
            if (!btn) return;

            const isLocked = btn.dataset.lock === 'true';
            const result = await window.couppaAdminAjax.postJson(`/Admin/User/Lock/${btn.dataset.id}`, { isLocked });
            if (result.success) {
                location.reload();
            } else {
                alert(result.error?.message || 'Không thể cập nhật trạng thái tài khoản.');
            }
        });
    </script>
}
