@model AdminUsersViewModel
@{
    ViewData["Title"] = "Quản lý Người dùng - Admin Couppa";
}

<div class="admin-wrapper" style="margin-top: -var(--space-6);">
    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right: 8px;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            Couppa Admin
        </div>

        <nav class="admin-menu">
            <a href="/Admin/Dashboard/Index" class="admin-menu-item">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a href="/Admin/Product/Index" class="admin-menu-item">
                <i class="bi bi-box-seam me-2"></i> Quản Lý Sản Phẩm
            </a>
            <a href="/Admin/Category/Index" class="admin-menu-item">
                <i class="bi bi-tags me-2"></i> Quản Lý Danh Mục
            </a>
            <a href="/Admin/User/Index" class="admin-menu-item active">
                <i class="bi bi-people me-2"></i> Quản Lý Người Dùng
            </a>
            <a href="/Admin/Report/CartTopProducts" class="admin-menu-item">
                <i class="bi bi-bar-chart me-2"></i> Báo Cáo Thống Kê
            </a>
        </nav>

        <div style="margin-top: auto; padding: var(--space-4); border-top: 1px solid #1E293B;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline btn-block btn-sm" style="color: #94A3B8; border-color: #334155;">&larr; Xem Website Public</a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="admin-main">
        <header class="admin-topbar">
            <h3>Quản Lý Danh Sách Người Dùng</h3>
        </header>

        <main class="admin-content">
            <div class="data-table-container">
                <div class="table-toolbar">
                    <span class="caption">Tổng số: <strong>@Model.Users.Count</strong> tài khoản</span>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Họ và Tên</th>
                            <th>Vai Trò (Role)</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Tạo</th>
                            <th style="text-align: right;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr data-id="@user.Id">
                                <td style="font-weight: 600;"><code>@user.Email</code></td>
                                <td>@user.FullName</td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "badge-info" : "badge-warning")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(user.IsLocked ? "badge-danger" : "badge-success")">
                                        @(user.IsLocked ? "Bị khóa" : "Hoạt động")
                                    </span>
                                </td>
                                <td class="caption">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn btn-outline btn-sm js-toggle-lock" data-id="@user.Id" data-lock="@((!user.IsLocked).ToString().ToLowerInvariant())" style="@(user.IsLocked ? "color: var(--color-success); border-color: var(--color-success);" : "color: var(--color-error); border-color: var(--color-error-light);")">
                                        <i class="bi @(user.IsLocked ? "bi-unlock" : "bi-lock") me-1"></i>
                                        @(user.IsLocked ? "Mở Khóa" : "Khóa Tài Khoản")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-ajax.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('.js-toggle-lock');
            if (!btn) return;

            const isLocked = btn.dataset.lock === 'true';
            const result = await window.couppaAdminAjax.postJson(`/Admin/User/Lock/${btn.dataset.id}`, { isLocked });
            if (result.success) {
                const locked = result.data.isLocked;
                btn.dataset.lock = (!locked).toString();
                btn.style = locked ? "color: var(--color-success); border-color: var(--color-success);" : "color: var(--color-error); border-color: var(--color-error-light);";
                btn.innerHTML = `<i class="bi ${locked ? 'bi-unlock' : 'bi-lock'} me-1"></i>${locked ? 'Mở Khóa' : 'Khóa Tài Khoản'}`;
                const status = btn.closest('tr')?.querySelector('td:nth-child(4) span');
                if (status) {
                    status.className = `badge ${locked ? 'badge-danger' : 'badge-success'}`;
                    status.textContent = locked ? 'Bị khóa' : 'Hoạt động';
                }
            } else {
                alert(result.error?.message || 'Không thể cập nhật trạng thái tài khoản.');
            }
        });
    </script>
}
